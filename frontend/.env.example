# The frontend calls the API with same-origin paths (/api, /ws).
# In development, Vite proxies them to the backend; override the target with:
# BACKEND_URL=http://localhost:8000
#
# Only set VITE_API_URL when the API is hosted on a different origin than the site
# (the backend's CORS_ORIGINS must then include this site's URL):
# VITE_API_URL=https://api.example.edu
